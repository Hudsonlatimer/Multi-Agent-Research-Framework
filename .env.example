# groq | together | gemini | ollama
LLM_PROVIDER=groq
MAX_REVISIONS=1

# Groq free tier: https://console.groq.com/keys
# Llama 3.1 / 3.3 chat IDs are enterprise-only. gpt-oss-120b is the free default.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Together.ai signup credits, not an ongoing free tier.
# Catalog checked October 2026: openai/gpt-oss-120b supports structured output.
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-120b

# Gemini key from Google AI Studio. Prefer this provider for long reports.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Ollama. No key. Pull the model once: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional. Unset means every role uses the provider model above.
# PLANNER_MODEL=
# RESEARCHER_MODEL=
# CRITIC_MODEL=
# WRITER_MODEL=
